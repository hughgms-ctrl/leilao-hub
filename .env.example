# ─── Banco ────────────────────────────────────────────────────────────────
# API (Vercel/serverless): use o POOLER da Supabase, porta 6543.
# Serverless abre muita conexão curta; a porta direta estoura o limite.
DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?sslmode=require

# Scraper e normalizer (VPS/cron): use a conexão DIRETA, porta 5432.
# São processos longos, com transações e muitos INSERTs — o pooler em
# modo transaction atrapalha (prepared statements, sessão).
DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require

# ─── Frontend ─────────────────────────────────────────────────────────────
# URL pública da API. Em dev local: http://localhost:3001
VITE_API_URL=http://localhost:3001
